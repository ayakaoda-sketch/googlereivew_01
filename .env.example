# Copy to .env.local and fill in. .env.local is git-ignored; this template is not.

# Where the dashboard reads data from: "mock" (built-in sample data) or "sheets".
DATA_SOURCE=mock

# --- Google Sheets (storage) ---------------------------------------------
# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Google sign-in (OAuth) — used for Sheets and Business Profile ----------
# Google Cloud → APIs & Services → Credentials → Create OAuth client ID → Desktop app.
# Consent screen: "Internal" (Workspace) so the sign-in does not expire after 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Filled in by `npm run google:auth` (sign in with the account that owns the sheet
# and manages the Business Profile locations).
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Alternative: service account key -------------------------------------
# Only if your organization allows service account key files. When set, these
# take precedence over OAuth for Sheets. Share the sheet with the email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the JSON key, on one line in double quotes, \n kept as-is.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Claude API (review analysis) -----------------------------------------
ANTHROPIC_API_KEY=

# Protects the daily collection endpoint from outside calls
CRON_SECRET=
